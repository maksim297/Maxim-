
package com.berserkofgluttony;

import net.minecraft.network.RegistryFriendlyByteBuf;
import net.minecraft.network.codec.StreamCodec;
import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
import net.minecraft.resources.ResourceLocation;

public record StatActionPayload(int statId, int direction)
        implements CustomPacketPayload {

    public static final Type<StatActionPayload> TYPE =
            new Type<>(
                    ResourceLocation.fromNamespaceAndPath(
                            BerserkOfGluttony.MODID,
                            "stat_action"
                    )
            );

    public static final StreamCodec<
            RegistryFriendlyByteBuf,
            StatActionPayload
    > STREAM_CODEC = StreamCodec.of(
            (buffer, payload) -> {
                buffer.writeVarInt(payload.statId());
                buffer.writeVarInt(payload.direction());
            },
            buffer -> new StatActionPayload(
                    buffer.readVarInt(),
                    buffer.readVarInt()
            )
    );

    @Override
    public Type<? extends CustomPacketPayload> type() {
        return TYPE;
    }
}
